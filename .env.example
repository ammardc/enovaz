APP_NAME=E-Novaz
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MariaDB (InnoDB). Gunakan akun runtime terbatas, bukan root. Lihat database/sql/grants.sql
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=enovaz_db
DB_USERNAME=enovaz_app
DB_PASSWORD=
# Akun migrasi/backup (DDL). Hanya dipakai skrip setup, backup, dan restore; aplikasi tidak memakainya.
DB_MIGRATOR_USERNAME=enovaz_migrator
DB_MIGRATOR_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Kunci enkripsi kredensial produk. Isi dengan: php artisan enovaz:credential-key
CREDENTIAL_KEY=

# Akun admin awal yang dibuat oleh seeder
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Pembayaran QRIS DANA Bisnis via Casaku
# fake = simulasi lokal; live = API Casaku sungguhan
# false = QRIS maintenance (beli hanya pakai saldo, saldo ditambah admin)
QRIS_ENABLED=false
CASAKU_DRIVER=fake
CASAKU_BASE_URL=https://api.casaku.id
CASAKU_LICENSE_KEY=
CASAKU_QR_ID=
CASAKU_PACKAGE_IDS=id.dana
CASAKU_WEBHOOK_SECRET=
CASAKU_EXPIRES_MINUTES=15
CASAKU_PREFIX=ENV

REAUTH_SECONDS=600
MAX_PENDING_ORDERS=3
SUPPORT_EMAIL=support@enovaz.id
SUPPORT_TELEGRAM=

VITE_APP_NAME="${APP_NAME}"
