# Environment variables untuk Docker
# Copy file ini ke .env dan sesuaikan dengan kebutuhan

APP_NAME="E-Novaz"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (Docker)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=enovaz
DB_USERNAME=enovaz
DB_PASSWORD=secret

# Redis Configuration (Docker)
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cache & Session (using Redis in Docker)
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# Queue (using Redis in Docker)
QUEUE_CONNECTION=redis

# Mail Configuration (using MailHog in Docker)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@enovaz.local"
MAIL_FROM_NAME="${APP_NAME}"

# E-Novaz Store Configuration
PAYMENTS_ENABLED=false
CASAKU_LIVE_VERIFIED=false
CASAKU_LICENSE_KEY=
CASAKU_WEBHOOK_SECRET=
CASAKU_QR_ID=
CASAKU_PACKAGE_IDS=id.dana
CASAKU_BASE_URL=https://api.casaku.id

# IMPORTANT: Generate with: php artisan tinker -> base64_encode(random_bytes(32))
# Or: openssl rand -base64 32
INVENTORY_KEY=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Telegram Support (optional)
TELEGRAM_URL=

# Top-up Limits
TOPUP_MIN_IDR=10000
TOPUP_MAX_IDR=2000000

# Broadcasting
BROADCAST_CONNECTION=log

# Filesystem
FILESYSTEM_DISK=local

# Vite
VITE_APP_NAME="${APP_NAME}"
